# TrueForge CloudSentinel Environment Configuration Template
# Copy this file to .env and configure local secrets

# TrueForge Agent Orchestration
TRUEFORGE_API_KEY=
TRUEFORGE_AGENT_ID=cloudsentinel-ai
TRUEFORGE_WORKSPACE_ID=

# FastMCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=6274
MCP_DEBUG=false

# AWS Simulation Settings (Local Moto In-Memory Sandbox)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=testing-mock-key
AWS_SECRET_ACCESS_KEY=testing-mock-secret

# Policy Engine Settings
CEDAR_FAIL_CLOSED=true
POLICY_PATH=cloudsentinel/policies/zerotrust.cedar
