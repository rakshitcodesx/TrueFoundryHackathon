{   "AWSTemplateFormatVersion": "2010-09-09",   "Resources": {     "FinancialDataBucket": {       "Type": "AWS::S3::Bucket",       "Properties": {         "BucketName": "company-financial-records",         "BucketEncryption": {           "ServerSideEncryptionConfiguration": [             {               "ServerSideEncryptionByDefault": {                 "SSEAlgorithm": "AES256"               }             }           ]         },         "PublicAccessBlockConfiguration": {           "BlockPublicAcls": true,           "BlockPublicPolicy": true,           "IgnorePublicAcls": true,           "RestrictPublicBuckets": true         },         "VersioningConfiguration": {           "Status": "Enabled"         }       }     },     "AppSecurityGroup": {       "Type": "AWS::EC2::SecurityGroup",       "Properties": {         "GroupDescription": "Application Server SG"       }     },     "DatabaseSecurityGroup": {       "Type": "AWS::EC2::SecurityGroup",       "Properties": {         "GroupDescription": "Database access restricted to app tier",         "SecurityGroupIngress": [           {             "IpProtocol": "tcp",             "FromPort": 5432,             "ToPort": 5432,             "SourceSecurityGroupId": {               "Fn::GetAtt": ["AppSecurityGroup", "GroupId"]             }           }         ]       }     }   } }